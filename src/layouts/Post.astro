---
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  tags: string[];
  description: string;
}

const { title, date, tags, description } = Astro.props;

const formatted = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---
<Base title={title} description={description}>
  <article>
    <header class="mb-10">
      <div class="text-xs mb-3" style="color: var(--muted);">
        <time datetime={date.toISOString()}>{formatted}</time>
        {tags.length > 0 && (
          <span class="ml-3">
            {tags.map(tag => (
              <span class="mr-2">#{tag}</span>
            ))}
          </span>
        )}
      </div>
      <h1 class="text-xl font-semibold leading-snug" style="letter-spacing: -0.02em;">
        {title}
      </h1>
      {description && (
        <p class="mt-3 text-sm" style="color: var(--muted);">{description}</p>
      )}
    </header>

    <div class="prose prose-sm max-w-none dark:prose-invert"
         style="--tw-prose-body: var(--fg); --tw-prose-headings: var(--fg); --tw-prose-lead: var(--muted); --tw-prose-links: var(--accent); --tw-prose-bold: var(--fg); --tw-prose-counters: var(--muted); --tw-prose-bullets: var(--muted); --tw-prose-hr: var(--border); --tw-prose-quotes: var(--muted); --tw-prose-quote-borders: var(--border); --tw-prose-captions: var(--muted); --tw-prose-code: var(--fg); --tw-prose-pre-code: var(--fg); --tw-prose-pre-bg: var(--border); --tw-prose-th-borders: var(--border); --tw-prose-td-borders: var(--border);">
      <slot />
    </div>
  </article>

  <nav class="mt-12">
    <a href="/" class="text-xs" style="color: var(--muted);">&larr; all posts</a>
  </nav>
</Base>
