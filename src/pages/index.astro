---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Eric Nguyen — blog">
  <h1 class="text-lg font-semibold mb-10" style="letter-spacing: -0.02em;">
    writing
  </h1>

  {posts.length === 0 && (
    <p class="text-sm" style="color: var(--muted);">no posts yet.</p>
  )}

  <ul class="space-y-8">
    {posts.map(post => {
      const date = post.data.date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
      });
      return (
        <li>
          <a href={`/blog/${post.slug}`} class="group block">
            <div class="text-xs mb-1" style="color: var(--muted);">
              <time datetime={post.data.date.toISOString()}>{date}</time>
              {post.data.tags.map(tag => (
                <span class="ml-2">#{tag}</span>
              ))}
            </div>
            <div class="text-sm font-medium group-hover:underline underline-offset-4 decoration-1">
              {post.data.title}
            </div>
            {post.data.description && (
              <p class="text-xs mt-1" style="color: var(--muted);">
                {post.data.description}
              </p>
            )}
          </a>
        </li>
      );
    })}
  </ul>
</Base>
